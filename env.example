# Rinomina questo file in .env e inserisci le tue chiavi

# "serper" (consigliato) oppure "google" (solo se hai già una chiave Custom Search)
SEARCH_BACKEND=serper

# https://serper.dev -> Sign up -> API key
SERPER_API_KEY=

# Solo per SEARCH_BACKEND=google (vecchia chiave dell'Apps Script)
GOOGLE_API_KEY=
GOOGLE_CX=

# Quante pagine da 10 risultati per piattaforma
PAGES_PER_QUERY=3
