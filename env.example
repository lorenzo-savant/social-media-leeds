# Kopiera den här filen till .env och fyll i dina nycklar

# En eller flera sökbackends, kommaseparerade:
#   ddg     = DuckDuckGo, GRATIS, ingen nyckel (standard)
#   exa     = Exa, gratis månadskvot, kräver EXA_API_KEY
#   serper  = Google-resultat via Serper, kräver SERPER_API_KEY
#   google  = gamla Google Custom Search, kräver GOOGLE_API_KEY + GOOGLE_CX
# Rekommenderat gratis: ddg,exa
SEARCH_BACKEND=ddg

# https://dashboard.exa.ai -> API Keys
EXA_API_KEY=

# https://serper.dev -> Sign up -> API key
SERPER_API_KEY=

# Bara för SEARCH_BACKEND=google (den gamla nyckeln från Apps Script)
GOOGLE_API_KEY=
GOOGLE_CX=

# Antal sidor med 10 resultat per plattform
PAGES_PER_QUERY=3

# true = hämta fulltexten för LinkedIn-annonser med crawl4ai
# (kräver: pip install -r requirements-crawl4ai.txt && crawl4ai-setup)
ENRICH_WITH_CRAWL4AI=false
